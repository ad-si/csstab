{
  "name": "csstab",
  "version": "1.0.0",
  "description": "Quickly look up CSS properties and selectors.",
  "type": "module",
  "scripts": {
    "build": "mkdir -p css && sass --style=compressed sass/screen.sass > css/screen.css",
    "clean": "rm -rf css",
    "lint": "eslint js/csstab.js js/properties.js js/selectors.js",
    "test": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ad-si/csstab"
  },
  "keywords": [
    "CSS"
  ],
  "author": "Adrian Sieber",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ad-si/csstab/issues"
  },
  "homepage": "https://github.com/ad-si/csstab#readme",
  "dependencies": {
    "shaven": "^1.3.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "sass": "^1.16.1"
  }
}
